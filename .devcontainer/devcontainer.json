{
  "name": "Deriv Signal Lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "postCreateCommand": "cd backend && pip install -e '.[dev]' && cd ../frontend && npm ci",
  "forwardPorts": [8000, 5173],
  "customizations": { "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint"] } }
}
