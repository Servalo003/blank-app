# ---- Deriv Signal Lab configuration (environment variables only; never commit .env) ----
APP_ENV=production
# Bearer token the web app must send. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=
POSTGRES_PASSWORD=
CORS_ORIGINS=http://localhost:8080
GIT_SHA=dev
LOG_LEVEL=INFO

# simulator | deriv
DATA_PROVIDER=simulator
SIMULATOR_SEED=7

# Deriv public market data needs NO token. Only the public endpoint is used.
DERIV_ENVIRONMENT=public
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
# Optional, kept for future authenticated read-only use; unused by this build. Never put a trade-scoped token here.
DERIV_APP_ID=
DERIV_API_TOKEN=
DERIV_RATE_PER_MINUTE=180
DERIV_RATE_PER_HOUR=12000

# Scanning
SCAN_DELAY_SECONDS=5
SCAN_LOOKBACK_BARS=600
STALE_AFTER_BARS=2

# Paper account and risk defaults (editable in the app, audited; hard cap 2% per trade)
PAPER_EQUITY=10000
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2
MAX_OPEN_POSITIONS=3
RESEARCH_ONLY_ALERTS=false
ALLOW_SIMULATED_ACTIONABLE=false

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
